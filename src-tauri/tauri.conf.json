{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShackCQ Desktop Nexus Review 6.8",
  "mainBinaryName": "shackcq-desktop-nexus-review",
  "version": "1.14.0-review.6.8",
  "identifier": "app.shackcq.desktop.nexusreview6",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "cd ../ui && npm run dev",
    "beforeBuildCommand": "cd ../ui && npm run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "ShackCQ Desktop — Nexus Review 6.8",
        "label": "main",
        "width": 1200,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 960,
        "height": 540,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$PICTURE/ShackCQ Desktop Nexus Review SSTV/**", "$LOCALDATA/ShackCQ Desktop Nexus Review/sstv-gallery/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": false,
    "targets": "all",
    "category": "Utility",
    "publisher": "ShackCQ",
    "copyright": "Copyright (C) 2026 KD9TAW and ShackCQ contributors. GPL-3.0-only.",
    "shortDescription": "ShackCQ Desktop review build based on Nexus v1.14.0",
    "longDescription": "An isolated ShackCQ Desktop review distribution based on the complete GPLv3 Nexus v1.14.0 application, retaining its Digi, radio, multi-radio, Hamlib, rotator, satellite, logbook and operating capabilities while adding bounded ShackCQ website synchronization.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hamlib/*": "resources/hamlib/",
      "resources/deepcw/*": "resources/deepcw/",
      "resources/tles/*": "resources/tles/",
      "../ui/src/data/cqzones.LICENSE.txt": "resources/data/cqzones.LICENSE.txt",
      "../licenses/remote/*": "resources/remote/",
      "../licenses/openssl/*": "resources/openssl/",
      "../COPYING": "COPYING",
      "../NOTICE": "NOTICE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Italian",
          "German",
          "French",
          "Spanish",
          "Portuguese",
          "Dutch",
          "Japanese"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libhamlib-utils", "libgfortran5", "libfftw3-single3", "libssl3"]
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
