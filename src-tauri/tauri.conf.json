{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RD-Nexus",
  "mainBinaryName": "RD-Nexus",
  "version": "1.15.0",
  "identifier": "com.kd9taw.tempo",
  "build": {
    "frontendDist": "../ui/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm --prefix ui run dev",
    "beforeBuildCommand": "npm --prefix ui run build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "RD-Nexus",
        "label": "main",
        "url": "blank.html",
        "width": 1200,
        "height": 720,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "splashscreen",
        "url": "splashscreen.html",
        "width": 960,
        "height": 540,
        "decorations": false,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$PICTURE/Nexus SSTV/**", "$LOCALDATA/Nexus/sstv-gallery/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "category": "Utility",
    "publisher": "KD9TAW",
    "copyright": "Copyright (C) 2026 KD9TAW. GPL-3.0-only.",
    "shortDescription": "RD-Nexus unified ham digital-ops center",
    "longDescription": "RD-Nexus builds on Nexus as a unified, native ham digital-operations center with two-way Wavelog synchronisation and an operator-focused workflow.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/hamlib/*.txt": "resources/hamlib/",
      "resources/hamlib/rig*": "resources/hamlib/",
      "resources/hamlib/rot*": "resources/hamlib/",
      "resources/hamlib/*.dylib": "resources/hamlib/",
      "resources/deepcw/*": "resources/deepcw/",
      "resources/tles/*": "resources/tles/",
      "../licenses/remote/*": "resources/remote/",
      "../licenses/openssl/*": "resources/openssl/",
      "../COPYING": "COPYING",
      "../NOTICE": "NOTICE"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller",
        "silent": false
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "languages": [
          "English",
          "Italian",
          "German",
          "French",
          "Spanish",
          "Portuguese",
          "Dutch",
          "Japanese"
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": ["libhamlib-utils", "libgfortran5", "libfftw3-single3", "libssl3"]
      }
    },
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUxMDdDMUU4NzZFNzVDQkIKUldTN1hPZDI2TUVIVVpDZDRVb0QxS1ZLWE0zUndyMmNCZFZNM1ptT3M0dnAraXJzSGtiamNqTlMK",
      "endpoints": ["https://github.com/oliverbross/RD-Nexus/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
